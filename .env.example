# ─── Authentication ───
NEXT_PUBLIC_AUTH_TOKEN=your-bearer-token-here

# ─── Bitget API ───
BITGET_API_KEY=your-bitget-api-key
BITGET_SECRET_KEY=your-bitget-secret-key
BITGET_PASSPHRASE=your-bitget-passphrase

# ─── LLM Engine ───
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=sk-local
LLM_MODEL=gemma-4-e2b-it-qat
LLM_MODEL_FAST=gemma-4-e2b-it-qat
LLM_PLUS_TIMEOUT_MS=30000
LLM_CYCLE_TIMEOUT_MS=15000
LLM_FALLBACK=true

# Hard daily loss limit (USD) — agent stops if daily loss exceeds this
# Negative value = loss limit (e.g., -100 = stop if daily loss >= $100)
DAILY_PNL_LIMIT_USD=-100

# ─── Trading ───
SIM_INITIAL_CASH=1000
SIM_ORDER_SIZE_PCT=0.05
SIM_FEE_PCT=0.001
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
BACKTEST_TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,PEPEUSDT
MAX_ACTIVE_POSITIONS=5
AGENT_CYCLE_INTERVAL_MS=30000

# Coin screening pool size and refresh interval (runtime-only, no LLM)
SCREEN_POOL_SIZE=20
# Maximum number of symbols concurrently sent to the LLM (default: 2)
# Any remaining watchlist symbols will still update in the UI but are skipped from LLM cycle
EVAL_MAX_PAIRS=2
WATCHLIST_REFRESH_MS=300000
SCREENING_MODE=momentum
REVERSAL_DECLINE_THRESHOLD=5

# Cache TTL for sentiment & news (minutes — avoids redundant API calls)
SENTIMENT_CACHE_TTL_MINUTES=120
NEWS_CACHE_TTL_MINUTES=30

# Cooldown after auto-bracket (SL/TP) exit before the LLM can re-enter that symbol
RECENT_EXIT_COOLDOWN_MS=600000

# Global SL/TP fallbacks (used when LLM doesn't set riskProfile)
SIM_STOP_LOSS_PCT=5
SIM_TAKE_PROFIT_PCT=10

# Risk Profile SL/TP configs (used when LLM sets riskProfile)
RISK_SL_TIGHT=3
RISK_TP_TIGHT=9
RISK_SL_NORMAL=5
RISK_TP_NORMAL=10
RISK_SL_WIDE=8
RISK_TP_WIDE=16

# When true, LLM directly outputs slPct/tpPct numbers per trade, completely
# ignoring RISK_PROFILES and the SIM_STOP_LOSS_PCT/SIM_TAKE_PROFIT_PCT fallbacks.
# The persona still influences the LLM's choices through the system prompt.
LLM_RISKPROFILE=false

# ─── Optional Proxy ───
# BITGET_PROXY=http://user:pass@host:port
